{
  "name": "suits",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:init": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/init-db.ts",
    "admin:init": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/create-admin.ts",
    "seed:presentation": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-presentation.mjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "demo:check": "node scripts/dev-demo.mjs --check",
    "verify:integration": "node scripts/validate-integration.mjs"
  },
  "dependencies": {
    "next": "^16.4.2",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
