# Sem banco compartilhado? Execute npm run dev:demo, sem configurar este arquivo.
# Copie para .env.local e ajuste para o seu PostgreSQL.
# Para serviços remotos, use as opções TLS fornecidas pelo provedor na URL.
DATABASE_URL=postgresql://postgres:senha@localhost:5432/suits
# Opcional: token Hugging Face para maior cota no Provador Virtual acadêmico.
# HF_TOKEN=hf_seu_token
# Em hospedagem com proxy reverso, informe a origem pública exata.
# APP_ORIGIN=https://suits.exemplo.com

# Opcional: banco exclusivo de testes; nunca use o banco de produção.
# TEST_DATABASE_URL=postgresql://postgres:senha@localhost:5432/suits_test
